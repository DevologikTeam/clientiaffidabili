# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3001

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=clientiaffidabili
POSTGRES_USER=clientiaffidabili
POSTGRES_PASSWORD=change_me_local
DATABASE_URL=postgresql://clientiaffidabili:change_me_local@postgres:5432/clientiaffidabili

# Auth
JWT_SECRET=change_me_with_strong_secret
JWT_EXPIRES_IN=8h

# Openapi provider - keep server side only
OPENAPI_BASE_URL=https://api.openapi.com
OPENAPI_OAUTH_URL=https://oauth.openapi.com
OPENAPI_EMAIL=
OPENAPI_API_KEY=
OPENAPI_TOKEN_TTL_SECONDS=3600
OPENAPI_CALLBACK_SECRET=change_me_callback_secret

# Billing
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancel

# Operational safety
ENABLE_PROVIDER_CALLS=false
ENABLE_CHECKOUT=false
ENABLE_DEMO_DATA=true
RETENTION_DAYS_REPORTS=180
CHECKOUT_MOCK_AUTO_CONFIRM=false
BILLING_INVOICE_MODE=manual_assisted
BILLING_DEFAULT_COUNTRY=IT
BILLING_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_LEDGER_STRICT_APPEND_ONLY=true

PROVIDER_ENVIRONMENT=sandbox


# Payment providers and subscriptions
ENABLE_STRIPE_PAYMENTS=false
ENABLE_PAYPAL=false
ENABLE_SUBSCRIPTIONS=false
ENABLE_REFUNDS=false
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Security / production gate
REAL_BUILD_VERIFIED=false
OBJECT_AUTH_VERIFIED=false
WEBHOOK_SECURITY_VERIFIED=false
SECRET_SCAN_VERIFIED=false
RESTORE_DRILL_VERIFIED=false
ENABLE_SECURITY_PRODUCTION_GATE=true
SECURITY_STRICT_HEADERS=true
SECURITY_AUDIT_READS=false
SECURITY_REDACT_LOGS=true

# M13-A launch readiness / E2E analysis placeholders
APP_PUBLIC_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:3001
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:3001
E2E_ADMIN_EMAIL=admin@example.test
E2E_ADMIN_PASSWORD=change-me-in-secrets
E2E_CUSTOMER_EMAIL=customer@example.test
E2E_CUSTOMER_PASSWORD=change-me-in-secrets
ENABLE_LAUNCH_PRODUCTION_GATE=false
ENABLE_BROWSER_E2E=false
ENABLE_SMOKE_TESTS=false

# M13-P launch readiness design
E2E_ARTIFACTS_DIR=playwright-report
E2E_JUNIT_OUTPUT=test-results/e2e-junit-results.xml
ENABLE_E2E_SEED=false
ENABLE_PRODUCTION_QA_GATE=false
LAUNCH_SIGNOFF_REQUIRED=true

# M13-S launch readiness / E2E
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_API_URL=http://localhost:3001
LAUNCH_GATE_REQUIRE_REAL_BUILD=false
LAUNCH_GATE_REQUIRE_E2E=false
LAUNCH_GATE_REQUIRE_DOCKER_SMOKE=false
LAUNCH_TEST_ACCOUNT_EMAIL=qa@clientiaffidabili.it
LAUNCH_TEST_ACCOUNT_PASSWORD=change_me_only_for_local_qa
ENABLE_E2E_FIXTURE_SEED=false

# Bootstrap admin and admin-managed settings roadmap
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Super Admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_CREATE_ON_START=false
PURCHASES_ENABLED=true
PAYMENT_SETTINGS_ADMIN_ENABLED=true
OPENAPI_SETTINGS_ADMIN_ENABLED=true
OPENAI_SETTINGS_ADMIN_ENABLED=false
OPERATIONAL_ERROR_LEDGER_ENABLED=true
SAVE_BUYER_IP_ENABLED=true

BOOTSTRAP_ADMIN_ENABLED=false
PURCHASES_ENABLED_DEFAULT=false
OPENAI_FEATURES_ENABLED=false
OPENAI_MONTHLY_BUDGET_CENTS=5000

# M21-S RC hardening runtime
RC_HARDENING_ENABLED=true
RC_ENV_FILE=.env
RC_REQUIRE_LOCKFILE=true
RC_REQUIRE_REAL_BUILD=true
RC_REQUIRE_REAL_DOCKER=true
RC_REQUIRE_REAL_PLAYWRIGHT=true
RC_REQUIRE_REAL_PROVIDER_SANDBOX=true
RC_REQUIRE_RESTORE_DRILL=true
RC_STRICT_PRODUCTION_GUARD=true
