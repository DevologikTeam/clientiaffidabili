    "qa:tag-manager-clarity-design": "node scripts/qa-tag-manager-clarity-design.js",
    "release:tag-manager-clarity-design-check": "node scripts/qa-tag-manager-clarity-design.js && node scripts/qa-source-syntax-smoke.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/typeorm": "^10.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^16.0.0",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0",
    "@clientiaffidabili/shared": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
